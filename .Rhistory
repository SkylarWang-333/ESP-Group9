parts <- regmatches(tokens, m)
df <- data.frame(
note  = sapply(parts, `[`, 2),
octave = as.integer(sapply(parts, `[`, 3)),
duration   = sapply(parts, `[`, 4),
stringsAsFactors = FALSE
)
