df$note <- substr(df$note,1,1)
df$note[df$duration=="||"] <- "||"
df$accidental[df$duration=="||"] <- ""
df$hz <- note_to_hz(df$note, df$accidental,df$octave)
df$dur <- duration_to_num(df$duration)
df <- df[,c("hz","dur")]
