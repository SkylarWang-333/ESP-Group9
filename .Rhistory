if(substr(str,nchar(str)-1,nchar(str)) == " |"){
str <- paste0(str,"|")
}
str <- gsub(" ||"," ||0||",str,fixed=TRUE)
str <- gsub(" | ", " |0| ",str,fixed=TRUE)
