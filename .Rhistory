##Q7
next_note <- function(key, M, w = NULL) {
# Maximum lag used to construct M
mlag <- ncol(M) - 1
# Use equal weights by default
if (is.null(w)) {
w <- rep(1, mlag)
}
}
if (length(key) > mlag) {
key <- tail(key, mlag)
}
##Q7
## Q7
next_note <- function(key, M, w = NULL) {
# Get the maximum lag from M
mlag <- ncol(M) - 1
# Set default weights to all 1s
if (is.null(w)) {
w <- rep(1, mlag)
}
# If key is longer than mlag, keep only the most recent tokens
if (length(key) > mlag) {
key <- tail(key, mlag)
}
# Create empty vectors for possible next tokens and their weights
u <- c()
p <- c()
# Check the key and its reduced versions
for (k in length(key):1) {
# Keep the last k tokens of key
current_key <- tail(key, k)
# Find the first column of M to be matched
mc <- mlag - k + 1
# Compare current_key with the corresponding columns of M
ii <- colSums(!(t(M[, mc:mlag, drop = FALSE]) == current_key))
# Find rows of M that completely match current_key
matches <- which(ii == 0)
# If matches are found, collect their next tokens and weights
if (length(matches) > 0) {
next_tokens <- M[matches, mlag + 1]
u <- c(u, next_tokens)
current_p <- rep(w[k] / length(matches), length(matches))
p <- c(p, current_p)
}
}
# If there are no usable matches, sample from the final column of M
if (length(u) == 0 || sum(p) == 0) {
next <- sample(M[, mlag + 1], size = 1)
# If there is only one possible next token, return it directly
} else if (length(u) == 1) {
next <- u[1]
# Otherwise, sample according to the mixture weights
} else {
next <- sample(u, size = 1, prob = p)
}
return(next)
}
