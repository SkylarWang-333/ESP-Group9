# ecdf using segments
ecdf2 <- function(x, ...){
# Description:
#   Plot the empirical cdf
# Inputs:
# x - numerical vector
n <- length(x)
p <- (1:n)/n    # cumulative probs
xs <- sort(x)   # sort into numerical order
# create a long vector, with NA between each segment coords
p1 <- x1 <- rep(NA, 3*n+2)
p1[(1:n)*3 + 2] <- p1[(1:n)*3 + 1] <- p
x1[(1:n)*3 + 1] <- xs
x1[(1:n)*3 + 2] <- c(xs[-1],2*xs[n]-xs[1])
p1[1:2] <- 0
x1[1:2] <- c(2*xs[1]-xs[n],xs[1])
# Create plotting frame and add points
plot(x = xs,    # x coordinate values
y = p,     # y coordinate values
pch = 19,  # point type, solid circle
cex=0.5,   # point size
xlab="x",  # axis labels
ylab=expression(P(X<=x)),
col = 4, ...)   # point colour (4 = blue)
# Add horizontal segments, with line
lines(x = x1, y = p1, col = 2, ...)
}
set.seed(8)
