# S5.9
ecdf <- function(x, ...){
# Description:
#   Plot the empirical cdf
# Inputs:
# x - numerical vector
n <- length(x)
p <- (1:n)/n    # cumulative probs
xs <- sort(x)   # sort into numerical order
# Create plotting frame and add points
plot(x = xs,    # x coordinate values
y = p,     # y coordinate values
pch = 19,  # point type, solid circle
cex=0.5,   # point size
xlab="x",  # axis labels
ylab=expression(P(X<=x)),
col = 4, ...)   # point colour (4 = blue)
# Add horizontal lines (col: 2 = red)
lines(x = c(2*xs[1]-xs[n], xs[1]),
y = c(0,0),
col = 2, ...)   #(2 = red)
for(i in 1:(n-1)){
lines(x = c(xs[i], xs[i+1]),
y = c(p[i], p[i]),
col = 2, ...)
}
lines(x = c(xs[n],2*xs[n]-xs[1]),
y = c(1,1),
col = 2, ...)   #(2 = red)
}
set.seed(8)
x <- rgamma(50, shape = 3, scale = 2)
ecdf(x, main = "version 1")
